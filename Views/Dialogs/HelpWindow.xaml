<Window x:Class="AwsManager.Views.Dialogs.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="AWS Manager | Aide"
        Height="700" Width="980" MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=HelpSearch}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style x:Key="HelpNavigationItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="12,12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E9EFED"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Background" Value="#D2EADF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,22">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <materialDesign:PackIcon Kind="BookOpenPageVariant" Width="32" Height="32" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel>
                        <TextBlock Text="Aide &amp; r&#xE9;f&#xE9;rences" FontFamily="{StaticResource HeadingFont}" FontSize="23"/>
                        <TextBlock Text="AWS Manager" Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Column="1" MaxWidth="320" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <TextBox x:Name="HelpSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormField}" Padding="38,10,38,10"
                             materialDesign:HintAssist.Hint="Rechercher dans l'aide" AutomationProperties.Name="Rechercher dans l'aide"/>
                    <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{StaticResource MutedInkBrush}" IsHitTestVisible="False"/>
                    <Button x:Name="ClearHelpSearch" Command="{Binding ClearSearchCommand}" Style="{StaticResource IconButton}"
                            Width="28" Height="28" Padding="4" Margin="0,0,7,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Visibility="{Binding HasSearch, Converter={StaticResource VisibleWhenTrue}}"
                            ToolTip="Effacer la recherche" AutomationProperties.Name="Effacer la recherche">
                        <materialDesign:PackIcon Kind="Close"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#F0F4F3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="12,20,12,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="12,0,12,14">
                        <TextBlock Text="RUBRIQUES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedInkBrush}"/>
                        <TextBlock Text="{Binding ResultLabel}" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedInkBrush}"/>
                    </StackPanel>
                    <ListBox x:Name="HelpTopics" ItemsSource="{Binding Topics}" SelectedItem="{Binding SelectedTopic}"
                             SelectionChanged="TopicSelectionChanged" ItemContainerStyle="{StaticResource HelpNavigationItem}"
                             Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Rubriques de l'aide">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="{Binding Icon}" Width="19" Height="19" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Background="{StaticResource SurfaceBrush}">
                <ScrollViewer x:Name="TopicScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasSelection, Converter={StaticResource VisibleWhenTrue}}">
                    <StackPanel x:Name="HelpArticle" Margin="28,26,28,28" DataContext="{Binding SelectedTopic}">
                        <TextBlock Text="{Binding Category}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TopicTitle" Text="{Binding Title}" FontFamily="{StaticResource HeadingFont}" FontSize="26" Margin="0,8,0,10" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedInkBrush}" FontSize="14" LineHeight="22" TextWrapping="Wrap"/>
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,22,0,22"/>
                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,22">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,7"/>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="22"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Background="#FFF5E4" BorderBrush="#C98B2B" BorderThickness="3,0,0,0" Padding="14,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers><DataTrigger Binding="{Binding Note}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Note}" Foreground="#725018" TextWrapping="Wrap" LineHeight="21"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel x:Name="HelpEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding HasResults}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <materialDesign:PackIcon Kind="Magnify" Width="36" Height="36" HorizontalAlignment="Center" Foreground="{StaticResource MutedInkBrush}" Margin="0,0,0,14"/>
                    <TextBlock Text="Aucune rubrique trouv&#xE9;e" FontFamily="{StaticResource HeadingFont}" FontSize="20" TextWrapping="Wrap" TextAlignment="Center"/>
                    <Button Command="{Binding ClearSearchCommand}" Style="{StaticResource ActionButton}" Margin="0,18,0,0" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="Effacer la recherche"/></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Julien Cosso" FontWeight="SemiBold" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding VersionLabel}" Foreground="{StaticResource MutedInkBrush}"/>
                </StackPanel>
                <Button x:Name="CloseHelpButton" Grid.Column="1" Click="CloseHelp" IsCancel="True" Style="{StaticResource ActionButton}">
                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="Fermer"/></StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
