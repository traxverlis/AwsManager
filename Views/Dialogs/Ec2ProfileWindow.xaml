<Window x:Class="AwsManager.Views.Dialogs.Ec2ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Profil IAM de l'instance"
        Width="700"
        Height="570"
        MinWidth="540"
        MinHeight="490"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Profil IAM"
                    Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="{Binding InstanceId}"
                    Style="{StaticResource ResourceIdentifier}"/>
            <ProgressBar Height="3"
                    IsIndeterminate="True"
                    Margin="0,12,0,0"
                    Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhenTrue}}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Etat EC2"
                        Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding InstanceState}"/>
                <TextBlock Text="Profil actuel"
                        Style="{StaticResource FieldLabel}"
                        Margin="0,14,0,4"/>
                <TextBlock Text="{Binding CurrentProfile}"
                        TextWrapping="Wrap"
                        FontFamily="Cascadia Mono, Consolas"/>
                <TextBlock Text="Nouveau profil d'instance"
                        Style="{StaticResource FieldLabel}"
                        Margin="0,14,0,4"/>
                <ComboBox x:Name="ProfileInput"
                        ItemsSource="{Binding Profiles}"
                        SelectedItem="{Binding SelectedProfile}"
                        DisplayMemberPath="DisplayName"
                        IsEnabled="{Binding CanEdit}"
                        IsTextSearchEnabled="True"/>
                <TextBlock Text="{Binding SelectedProfile.Arn}"
                        TextWrapping="Wrap"
                        Margin="0,8,0,0"
                        FontSize="12"/>
                <TextBlock Text="{Binding SelectedProfile.RoleArn}"
                        TextWrapping="Wrap"
                        Margin="0,4,0,0"
                        FontSize="12"/>
                <TextBlock Text="Le changement peut retirer les permissions des applications et l'acces SSM."
                        Foreground="Firebrick"
                        TextWrapping="Wrap"
                        Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2"
                Margin="0,16,0,0">
            <TextBlock Text="{Binding Status}"
                    TextWrapping="Wrap"
                    Margin="0,0,0,12"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button Command="{Binding RefreshCommand}"
                        Style="{StaticResource ToolButton}"
                        ToolTip="Actualiser le profil et les choix">
                    <materialDesign:PackIcon Kind="Refresh"/>
                </Button>
                <Button Content="Fermer"
                        IsCancel="True"
                        Style="{StaticResource ActionButton}"
                        Margin="0,0,10,0"/>
                <Button x:Name="ApplyProfileButton"
                        Command="{Binding ApplyCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Check"
                                Margin="0,0,8,0"/>
                        <TextBlock Text="Appliquer"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>