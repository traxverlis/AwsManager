<Window x:Class="AwsManager.Views.Dialogs.ASGTagEditorWindow"
        x:Name="ASGTagEditorControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:AwsManager.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:AutoScalingTagEditorViewModel, IsDesignTimeCreatable=True}"
        Title="Tags Auto Scaling"
        Height="500"
        Width="720"
        MinWidth="620"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                Margin="0,0,0,16">
            <TextBlock Text="Tags Auto Scaling"
                    Style="{StaticResource SectionTitle}"
                    FontSize="22"
                    Margin="0,0,0,6"/>
            <TextBlock Text="{Binding AutoScalingGroupName}"
                    Style="{StaticResource ResourceIdentifier}"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Tags}"
                  IsEnabled="{Binding CanEdit}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Clé"
                                    Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*"/>
                <DataGridTextColumn Header="Valeur"
                                    Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                    Width="2*"/>
                <DataGridCheckBoxColumn Header="Propager"
                                        Binding="{Binding PropageAtLaunch, UpdateSourceTrigger=PropertyChanged}"
                                        Width="90"/>
                <DataGridTemplateColumn Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.RemoveTagCommand, ElementName=ASGTagEditorControl}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Supprimer le tag"
                                    Style="{StaticResource IconButton}"
                                    Foreground="Firebrick">
                                <materialDesign:PackIcon Kind="DeleteOutline"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2"
                   Text="{Binding Status}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>
        <Border Grid.Row="3"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,16,0,0">
            <DockPanel LastChildFill="False">
                <Button Command="{Binding AddTagCommand}"
                        Style="{StaticResource ActionButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus"
                                Width="16"
                                Height="16"
                                Margin="0,0,8,0"/>
                        <TextBlock Text="Ajouter"/>
                    </StackPanel>
                </Button>
                <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal">
                    <Button Content="Fermer"
                            IsCancel="True"
                            Style="{StaticResource ActionButton}"
                            Margin="0,0,10,0"/>
                    <Button Content="Enregistrer"
                            Command="{Binding SaveChangesCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
