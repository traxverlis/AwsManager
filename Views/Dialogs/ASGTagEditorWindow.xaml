<Window x:Class="AwsManager.Views.Dialogs.ASGTagEditorWindow"
        x:Name="ASGTagEditorControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:AwsManager.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:AutoScalingTagEditorViewModel, IsDesignTimeCreatable=True}"
        Title="Tag Editor"
        Height="500" Width="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource MaterialDesignHeadline6TextBlock}">
            <Run Text="Editing Tags for:"/>
            <Run Text="{Binding InstanceId}" FontWeight="Bold"/>
        </TextBlock>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Tags}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                <DataGridCheckBoxColumn Header="Propagate at Launch" Binding="{Binding PropageAtLaunch, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                <DataGridTemplateColumn  Header="Delete" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.RemoveTagCommand, ElementName=ASGTagEditorControl}"
        CommandParameter="{Binding}"
        Style="{StaticResource MaterialDesignIconButton}">
                                <materialDesign:PackIcon Kind="DeleteOutline" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="Add Tag" Command="{Binding AddTagCommand}"/>
            <Button Content="Save Changes" Command="{Binding SaveChangesCommand}" IsDefault="True" Margin="10,0,0,0"/>
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
