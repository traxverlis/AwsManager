<Window x:Class="AwsManager.Views.Dialogs.SsmConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:AwsManager.ViewModels"
        mc:Ignorable="d"
        Title="SSM Connection" Height="Auto" Width="600"
        d:DataContext="{d:DesignInstance Type=viewmodels:SsmConnectionViewModel, IsDesignTimeCreatable=True}"
        WindowStartupLocation="CenterOwner" SizeToContent="Height">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <StackPanel Margin="16">
        <TextBlock Text="SSM Connection" Style="{StaticResource MaterialDesignHeadline5TextBlock}" />
        <TextBlock Margin="0,5,0,0">
            <Run Text="Target Instance:"/>
            <Run Text="{Binding TargetInstance.Name}" FontWeight="Bold"/>
            <Run Text="("/><Run Text="{Binding TargetInstance.InstanceId}"/><Run Text=")"/>
        </TextBlock>

        <TabControl Margin="0,20,0,0">
            <!-- SSH Tab -->
            <TabItem Header="SSH" Visibility="{Binding IsLinux, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Margin="10">
                    <TextBlock Text="Start a direct SSH session into the instance." TextWrapping="Wrap" Margin="0,0,0,20"/>
                    <Button Content="Start SSH Session" Command="{Binding StartSshCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>

            <!-- RDP Tab -->
            <TabItem Header="RDP" Visibility="{Binding IsWindows, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Margin="10">
                    <TextBlock Text="Create a secure tunnel to the instance for Remote Desktop." TextWrapping="Wrap" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding RdpRemotePort}" materialDesign:HintAssist.Hint="Remote Port" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="5" Width="100"/>
                        <TextBox Text="{Binding RdpLocalPort}" materialDesign:HintAssist.Hint="Local Port" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="5" Width="100"/>
                    </StackPanel>
                    <Button Content="Start RDP Tunnel" Command="{Binding StartRdpTunnelCommand}" HorizontalAlignment="Left" Margin="5,20,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- Custom Port Forwarding Tab -->
            <TabItem Header="Port Forwarding">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding CustomRules}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Remote Port" Binding="{Binding RemotePort}"/>
                            <DataGridTextColumn Header="Local Port" Binding="{Binding LocalPort}"/>
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}">
                                            <materialDesign:PackIcon Kind="Delete" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Add Rule" Command="{Binding AddRuleCommand}"/>
                        <Button Content="Start Tunnels" Command="{Binding StartCustomTunnelCommand}" Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </StackPanel>
</Window>
