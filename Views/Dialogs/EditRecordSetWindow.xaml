<Window x:Class="AwsManager.Views.Dialogs.EditRecordSetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:AwsManager.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:EditRecordSetViewModel, IsDesignTimeCreatable=True}"
        Title="Enregistrement DNS"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Width="620">
    <StackPanel Margin="24">
        <StackPanel Orientation="Horizontal"
                Margin="0,0,0,20">
            <materialDesign:PackIcon Kind="Dns"
                    Foreground="{StaticResource AccentBrush}"
                    Width="24"
                    Height="24"
                    Margin="0,0,10,0"/>
            <TextBlock Text="Enregistrement DNS"
                    Style="{StaticResource SectionTitle}"
                    FontSize="22"
                    Margin="0"/>
        </StackPanel>
        <TextBlock Text="Nom DNS"
                Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource FormField}"
                Margin="0,0,0,16"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Type"
                        Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding RecordTypes}"
                        SelectedItem="{Binding Type}"
                        Style="{StaticResource FormCombo}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="TTL (secondes, hors alias)"
                        Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Ttl, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                        Style="{StaticResource FormField}"/>
            </StackPanel>
        </Grid>
        <WrapPanel Margin="0,18,0,14">
            <CheckBox Content="Alias AWS"
                    IsChecked="{Binding IsAlias}"
                    Margin="0,0,24,0"/>
            <CheckBox Content="Évaluer la santé de la cible"
                    IsChecked="{Binding EvaluateTargetHealth}"/>
        </WrapPanel>
        <TextBlock Text="Zone cible de l'alias"
                Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding AliasZoneId, UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource FormField}"
                Margin="0,0,0,16"/>
        <TextBlock Text="Valeurs"
                Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource FormField}"
                 FontFamily="Cascadia Mono, Consolas"
                FontSize="13"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                VerticalScrollBarVisibility="Auto"
                Height="120"/>
        <TextBlock x:Name="ValidationText"
                Foreground="Firebrick"
                TextWrapping="Wrap"
                Margin="0,8,0,0"/>
        <Border BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Margin="0,16,0,0"
                Padding="0,16,0,0">
            <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
                <Button Content="Annuler"
                        IsCancel="True"
                        Style="{StaticResource ActionButton}"
                        Margin="0,0,10,0"/>
                <Button Content="Continuer"
                        IsDefault="True"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
