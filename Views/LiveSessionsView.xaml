<UserControl x:Class="AwsManager.Views.LiveSessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:AwsManager.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:LiveSessionsViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="600"
        d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal"
                Margin="5">
            <Button Command="{Binding KillSessionCommand}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="Fermer la connexion sélectionnée">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Close"
                            Margin="0,0,6,0"/>
                    <TextBlock Text="Fermer la connexion"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <DataGrid Grid.Row="1"
                ItemsSource="{Binding ActiveSessions}"
                SelectedItem="{Binding SelectedSession}"
                  AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                  Style="{StaticResource ResourceGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="PID"
                        Binding="{Binding ProcessId}"/>
                <DataGridTextColumn Header="Description"
                        Binding="{Binding Description}"
                        Width="*"/>
                <DataGridTextColumn Header="Ouverture"
                        Binding="{Binding StartTime, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
