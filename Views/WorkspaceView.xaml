<UserControl x:Class="AwsManager.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <DataTemplate x:Key="ResourceActions">
            <Button Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource IconButton}" ToolTip="Ouvrir la ressource">
                <materialDesign:PackIcon Kind="ArrowTopRight"/>
            </Button>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StorageError}" Foreground="Firebrick" TextWrapping="Wrap"/>
        <TabControl>
            <TabItem Header="Favoris">
                <DataGrid ItemsSource="{Binding Favorites}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,16,0,0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="60" CellTemplate="{StaticResource ResourceActions}"/>
                        <DataGridTextColumn Header="Ressource" Binding="{Binding Name}" Width="*" MinWidth="140" ElementStyle="{StaticResource ResourceName}"/>
                        <DataGridTextColumn Header="Service" Binding="{Binding Service}"/>
                        <DataGridTextColumn Header="Profil" Binding="{Binding Profile}"/>
                        <DataGridTextColumn Header="Compte" Binding="{Binding Account}" ElementStyle="{StaticResource ResourceIdentifier}"/>
                        <DataGridTextColumn Header="Région" Binding="{Binding Region}"/>
                        <DataGridTemplateColumn Width="60">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Button Command="{Binding DataContext.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Retirer des favoris" Style="{StaticResource IconButton}"><materialDesign:PackIcon Kind="StarOffOutline"/></Button>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Récents">
                <DockPanel Margin="0,16,0,0">
                    <Button DockPanel.Dock="Top" Command="{Binding ClearRecentCommand}" Style="{StaticResource ToolButton}" ToolTip="Effacer les accès récents" HorizontalAlignment="Right"><materialDesign:PackIcon Kind="DeleteSweepOutline"/></Button>
                    <DataGrid ItemsSource="{Binding Recent}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="60" CellTemplate="{StaticResource ResourceActions}"/>
                            <DataGridTextColumn Header="Ressource" Binding="{Binding Name}" Width="*" MinWidth="140" ElementStyle="{StaticResource ResourceName}"/>
                            <DataGridTextColumn Header="Service" Binding="{Binding Service}"/>
                            <DataGridTextColumn Header="Profil" Binding="{Binding Profile}"/>
                            <DataGridTextColumn Header="Compte" Binding="{Binding Account}"/>
                            <DataGridTextColumn Header="Région" Binding="{Binding Region}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Connexions">
                <DataGrid ItemsSource="{Binding Connections}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,16,0,0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <Button Command="{Binding DataContext.OpenConnectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource IconButton}" ToolTip="Préparer la connexion"><materialDesign:PackIcon Kind="Console"/></Button>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="Configuration" Binding="{Binding Name}" Width="*" MinWidth="140" ElementStyle="{StaticResource ResourceName}"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Mode}"/>
                        <DataGridTextColumn Header="Ressource" Binding="{Binding Target.Name}"/>
                        <DataGridTextColumn Header="Profil" Binding="{Binding Target.Profile}"/>
                        <DataGridTextColumn Header="Compte" Binding="{Binding Target.Account}"/>
                        <DataGridTextColumn Header="Région" Binding="{Binding Target.Region}"/>
                        <DataGridTemplateColumn Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <Button Command="{Binding DataContext.RemoveConnectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource IconButton}" ToolTip="Supprimer la configuration"><materialDesign:PackIcon Kind="DeleteOutline"/></Button>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Historique">
                <DockPanel Margin="0,16,0,0">
                    <Button DockPanel.Dock="Top" Command="{Binding ClearHistoryCommand}" Style="{StaticResource ToolButton}" ToolTip="Effacer l'historique local" HorizontalAlignment="Right"><materialDesign:PackIcon Kind="DeleteSweepOutline"/></Button>
                    <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Time, StringFormat={}{0:dd/MM HH:mm:ss zzz}}"/>
                            <DataGridTextColumn Header="Opération" Binding="{Binding Operation}"/>
                            <DataGridTextColumn Header="Ressource" Binding="{Binding Resource}" Width="*" MinWidth="140" ElementStyle="{StaticResource ResourceIdentifier}"/>
                            <DataGridTextColumn Header="Résultat" Binding="{Binding Result}"/>
                            <DataGridTextColumn Header="Profil" Binding="{Binding Profile}"/>
                            <DataGridTextColumn Header="Compte" Binding="{Binding Account}"/>
                            <DataGridTextColumn Header="Région" Binding="{Binding Region}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>