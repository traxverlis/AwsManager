<UserControl x:Class="AwsManager.Views.IamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding Scope}"
                       Foreground="{StaticResource MutedInkBrush}"
                       Margin="0,0,0,8"/>
            <TabControl x:Name="IamCategories"
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory}"
                        IsEnabled="{Binding CanEdit}"
                        Margin="0,0,0,8">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem"
                            BasedOn="{StaticResource {x:Type TabItem}}">
                        <Setter Property="IsEnabled"
                                Value="{Binding IsEnabled}"/>
                        <Setter Property="ToolTip"
                                Value="{Binding AccessHint}"/>
                        <Setter Property="ToolTipService.ShowOnDisabled"
                                Value="True"/>
                    </Style>
                </TabControl.ItemContainerStyle>
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid/>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <Button Command="{Binding RefreshCommand}"
                            ToolTip="Actualiser"
                            Style="{StaticResource ToolButton}">
                        <materialDesign:PackIcon Kind="Refresh"/>
                    </Button>
                    <Button Command="{Binding MoreCommand}"
                            ToolTip="Charger la page suivante"
                            Style="{StaticResource ToolButton}">
                        <materialDesign:PackIcon Kind="PageNextOutline"/>
                    </Button>
                    <Button Command="{Binding DetailsCommand}"
                            ToolTip="Relire les details"
                            Style="{StaticResource ToolButton}">
                        <materialDesign:PackIcon Kind="InformationOutline"/>
                    </Button>
                    <Button Command="{Binding CancelCommand}"
                            ToolTip="Annuler la lecture"
                            Style="{StaticResource ToolButton}">
                        <materialDesign:PackIcon Kind="Close"/>
                    </Button>
                </StackPanel>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SearchField}"
                         Margin="0,0,12,6"/>
            </DockPanel>
            <ProgressBar Height="3"
                         IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhenTrue}}"/>
        </StackPanel>
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding FilteredItems}"
                  SelectedItem="{Binding SelectedResource}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Style="{StaticResource ResourceGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nom"
                                    Binding="{Binding Name}"
                                    MinWidth="180"
                                    ElementStyle="{StaticResource ResourceName}"/>
                <DataGridTextColumn Header="Chemin"
                                    Binding="{Binding Path}"
                                    MinWidth="100"/>
                <DataGridTextColumn Header="ARN"
                                    Binding="{Binding Arn}"
                                    Width="*"
                                    MinWidth="230"
                                    ElementStyle="{StaticResource ResourceIdentifier}"/>
            </DataGrid.Columns>
        </DataGrid>
        <GridSplitter Grid.Row="2"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      Background="{StaticResource LineBrush}"/>
        <TextBox Grid.Row="3"
                 x:Name="IamDetails"
                 Text="{Binding Details, Mode=OneWay}"
                 IsReadOnly="True"
                 IsUndoEnabled="False"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Cascadia Mono, Consolas"
                 FontSize="12"
                 Margin="0,8,0,0"/>
        <TextBlock Grid.Row="4"
                   Text="{Binding Status}"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource MutedInkBrush}"
                   Margin="0,8,0,0"/>
    </Grid>
</UserControl>