<UserControl x:Class="AwsManager.Views.PatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/></UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <WrapPanel IsEnabled="{Binding CanEdit}">
                <StackPanel Width="140" Margin="0,0,12,8"><TextBlock Text="Operation" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="OperationInput" ItemsSource="{Binding Operations}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Operation}"/></StackPanel>
                <StackPanel Width="90" Margin="0,0,12,8"><TextBlock Text="Concurrence" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Concurrency, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <StackPanel Width="110" Margin="0,0,12,8"><TextBlock Text="Erreurs tolerees" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding MaxErrors, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <CheckBox Content="Redemarrage autorise" IsChecked="{Binding AllowReboot}" IsEnabled="{Binding IsInstall}" VerticalAlignment="Center" Margin="0,12,12,0"/>
                <Button Command="{Binding PrepareCommand}" VerticalAlignment="Bottom" Margin="0,0,0,8" ToolTip="Relire les cibles et baselines avant confirmation"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ClipboardCheckOutline" Margin="0,0,8,0"/><TextBlock Text="Preparer"/></StackPanel></Button>
            </WrapPanel>
            <TextBlock Text="{Binding ValidationMessage}" Foreground="Firebrick" TextWrapping="Wrap" FontSize="12"/>
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,4,0,4" Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhenTrue}}"/>
        </StackPanel>
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}" Margin="0,8,0,0">
            <TabItem Header="Parc SSM">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Right">
                            <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Command="{Binding RefreshCommand}" Style="{StaticResource ToolButton}" ToolTip="Actualiser le parc"><materialDesign:PackIcon Kind="Refresh"/></Button>
                            <Button Command="{Binding PatchDetailsCommand}" Style="{StaticResource ToolButton}" ToolTip="Lire les correctifs de la machine"><materialDesign:PackIcon Kind="InformationOutline"/></Button>
                        </WrapPanel>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchField}" IsEnabled="{Binding CanEdit}" Margin="0,0,12,6"/>
                    </DockPanel>
                    <DataGrid Grid.Row="1" x:Name="NodesTable" ItemsSource="{Binding FilteredItems}" SelectedItem="{Binding SelectedNode}" IsEnabled="{Binding CanEdit}" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="OnNodeSelectionChanged" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource ResourceGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Machine" Binding="{Binding Name}" MinWidth="130" ElementStyle="{StaticResource ResourceName}"/>
                            <DataGridTextColumn Header="Identifiant" Binding="{Binding Id}" ElementStyle="{StaticResource ResourceIdentifier}"/>
                            <DataGridTextColumn Header="SSM" Binding="{Binding PingStatus}"/>
                            <DataGridTextColumn Header="OS" Binding="{Binding Platform}"/>
                            <DataGridTextColumn Header="Conformite" Binding="{Binding Compliance}"/>
                            <DataGridTextColumn Header="Manquants" Binding="{Binding Missing}"/>
                            <DataGridTextColumn Header="Critiques" Binding="{Binding Critical}"/>
                            <DataGridTextColumn Header="Echecs" Binding="{Binding Failed}"/>
                            <DataGridTextColumn Header="Redemarrage" Binding="{Binding PendingReboot}"/>
                            <DataGridTextColumn Header="Dernier releve" Binding="{Binding LastOperation}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBox Grid.Row="2" Text="{Binding PatchDetails, Mode=OneWay}" IsReadOnly="True" IsUndoEnabled="False" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>
            <TabItem Header="Preparation">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBox x:Name="PatchPreview" Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" IsUndoEnabled="False" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock Text="Une installation peut interrompre les services, meme sans redemarrage. Aucun retour arriere automatique." Foreground="Firebrick" TextWrapping="Wrap" Visibility="{Binding IsInstall, Converter={StaticResource VisibleWhenTrue}}"/>
                        <CheckBox x:Name="MaintenanceAcknowledged" Content="Fenetre de maintenance et sauvegardes verifiees" IsChecked="{Binding Acknowledged}" IsEnabled="{Binding CanEdit}" Margin="0,8,0,8" Visibility="{Binding IsInstall, Converter={StaticResource VisibleWhenTrue}}"/>
                        <Button x:Name="SubmitPatchButton" Command="{Binding SubmitCommand}" HorizontalAlignment="Right" Margin="0,4,0,0"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Play" Margin="0,0,8,0"/><TextBlock Text="Confirmer et lancer"/></StackPanel></Button>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Executions AWS">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Command="{Binding RefreshCommandsCommand}" Style="{StaticResource ToolButton}" ToolTip="Actualiser les commandes de correctifs"><materialDesign:PackIcon Kind="Refresh"/></Button>
                        <Button Command="{Binding MoreCommandsCommand}" Style="{StaticResource ToolButton}" ToolTip="Commandes suivantes"><materialDesign:PackIcon Kind="PageNextOutline"/></Button>
                        <Button Command="{Binding RefreshInvocationsCommand}" Style="{StaticResource ActionButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Sync" Margin="0,0,8,0"/><TextBlock Text="Resultats par machine"/></StackPanel></Button>
                    </WrapPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Commands}" SelectedItem="{Binding SelectedCommand}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Style="{StaticResource ResourceGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Commande" Binding="{Binding Id}"/>
                            <DataGridTextColumn Header="Operation" Binding="{Binding Operation}"/>
                            <DataGridTextColumn Header="Etat" Binding="{Binding Status}"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding Requested, StringFormat=yyyy-MM-dd HH:mm}"/>
                            <DataGridTextColumn Header="Cibles" Binding="{Binding Targets}"/>
                            <DataGridTextColumn Header="Terminees" Binding="{Binding Completed}"/>
                            <DataGridTextColumn Header="Erreurs" Binding="{Binding Errors}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Invocations}" SelectedItem="{Binding SelectedInvocation}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Style="{StaticResource ResourceGrid}" Margin="0,8,0,0">
                        <DataGrid.Columns><DataGridTextColumn Header="Machine" Binding="{Binding InstanceId}"/><DataGridTextColumn Header="Nom" Binding="{Binding Name}"/><DataGridTextColumn Header="Resultat" Binding="{Binding Status}" Width="*"/></DataGrid.Columns>
                    </DataGrid>
                    <TextBox Grid.Row="3" Text="{Binding CommandOutput, Mode=OneWay}" IsReadOnly="True" IsUndoEnabled="False" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Command="{Binding CancelCommand}" Style="{StaticResource ToolButton}" ToolTip="Annuler l'attente locale, sans arreter une commande deja envoyee"><materialDesign:PackIcon Kind="Close"/></Button>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</UserControl>