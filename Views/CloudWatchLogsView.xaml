<UserControl x:Class="AwsManager.Views.CloudWatchLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"
                    MinWidth="180"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"
                    MinWidth="420"/>
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Groupes de journaux"
                    Style="{StaticResource SectionTitle}"
                    Margin="0,0,0,12"/>
            <Grid Grid.Row="1"
                    Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Préfixe du groupe"
                            Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding GroupPrefix, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding CanEdit}"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource IconButton}"
                        VerticalAlignment="Bottom"
                        ToolTip="Rechercher les groupes">
                    <materialDesign:PackIcon Kind="Refresh"/>
                </Button>
            </Grid>
            <ListView Grid.Row="2"
                    ItemsSource="{Binding Groups}"
                    SelectedItem="{Binding SelectedGroup}"
                    Style="{StaticResource ResourceList}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4"
                                ToolTip="{Binding Name}">
                            <TextBlock Text="{Binding Name}"
                                    TextWrapping="Wrap"
                                    FontSize="12"/>
                            <TextBlock Text="{Binding Retention}"
                                    FontSize="11"
                                    Foreground="{StaticResource MutedInkBrush}"
                                    Margin="0,4,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button Grid.Row="3"
                    Command="{Binding MoreGroupsCommand}"
                    Style="{StaticResource ActionButton}"
                    HorizontalAlignment="Left"
                    Margin="0,8,0,4">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ChevronDown"
                            Margin="0,0,6,0"/>
                    <TextBlock Text="Groupes suivants"/>
                </StackPanel>
            </Button>
            <TextBlock Grid.Row="4"
                    Text="{Binding GroupStatus}"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource MutedInkBrush}"
                    FontSize="11"/>
        </Grid>
        <GridSplitter Grid.Column="1"
                Width="4"
                HorizontalAlignment="Center"
                Background="{StaticResource LineBrush}"
                ResizeBehavior="PreviousAndNext"/>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"
                        MinHeight="95"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="0.65*"
                        MinHeight="85"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding SelectedGroup.Name, TargetNullValue=CloudWatch Logs}"
                    Style="{StaticResource SectionTitle}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding SelectedGroup.Name}"
                    Margin="0,0,0,10"/>
            <Grid Grid.Row="1"
                    Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="Période"
                            Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Periods}"
                            SelectedItem="{Binding SelectedPeriod}"
                            DisplayMemberPath="Name"
                            IsEnabled="{Binding CanEdit}"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                        Grid.ColumnSpan="3"
                        Margin="0,0,0,8">
                    <TextBlock Text="Préfixe du flux"
                            Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding StreamPrefix, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding CanEdit}"/>
                </StackPanel>
                <StackPanel Grid.Row="1"
                        Grid.ColumnSpan="2">
                    <TextBlock Text="Filtre CloudWatch"
                            Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PatternInput"
                            Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding CanEdit}"/>
                </StackPanel>
                <Button Grid.Row="1"
                        Grid.Column="2"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource IconButton}"
                        ToolTip="Rechercher les événements"
                        VerticalAlignment="Bottom">
                    <materialDesign:PackIcon Kind="Magnify"/>
                </Button>
                <Button Grid.Row="1"
                        Grid.Column="3"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource IconButton}"
                        ToolTip="Annuler la lecture"
                        VerticalAlignment="Bottom">
                    <materialDesign:PackIcon Kind="Close"/>
                </Button>
            </Grid>
            <DataGrid Grid.Row="2"
                    ItemsSource="{Binding Events}"
                    SelectedItem="{Binding SelectedEvent}"
                    Style="{StaticResource ResourceGrid}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    RowHeight="34"
                    ClipboardCopyMode="None">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date UTC"
                            Binding="{Binding TimeUtc}"
                            Width="170"/>
                    <DataGridTextColumn Header="Flux"
                            Binding="{Binding Stream}"
                            Width="130"/>
                    <DataGridTextColumn Header="Message"
                            Binding="{Binding Preview}"
                            Width="*"
                            MinWidth="100"/>
                </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Row="5"
                    Margin="0,8,0,0">
                <Button DockPanel.Dock="Right"
                        Command="{Binding MoreEventsCommand}"
                        Style="{StaticResource ActionButton}"
                        Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ChevronDown"
                                Margin="0,0,6,0"/>
                        <TextBlock Text="Charger la suite"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding Status}"
                        TextWrapping="Wrap"
                        VerticalAlignment="Center"
                        FontSize="12"/>
            </DockPanel>
            <GridSplitter Grid.Row="3"
                    Height="4"
                    HorizontalAlignment="Stretch"
                    Background="{StaticResource LineBrush}"
                    ResizeDirection="Rows"
                    ResizeBehavior="PreviousAndNext"/>
            <Grid Grid.Row="4"
                    Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Command="{Binding CopyMessageCommand}"
                            Style="{StaticResource IconButton}"
                            ToolTip="Copier le message">
                        <materialDesign:PackIcon Kind="ContentCopy"/>
                    </Button>
                    <TextBlock Text="Message complet"
                            Style="{StaticResource FieldLabel}"
                            VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox x:Name="MessageDetail"
                        Grid.Row="1"
                        Text="{Binding SelectedEvent.Message, Mode=OneWay}"
                        IsReadOnly="True"
                        IsUndoEnabled="False"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"/>
            </Grid>
            <TextBlock Grid.Row="6"
                    Text="{Binding RangeSummary}"
                    FontSize="11"
                    Foreground="{StaticResource MutedInkBrush}"
                    Margin="0,8,0,0"
                    TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</UserControl>