<UserControl x:Class="AwsManager.Views.SecurityGroupView"
             x:Name="SecurityGroupViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:AwsManager.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:SecurityGroupViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="600"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <DataTemplate x:Key="RuleActions">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding DataContext.EditRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        ToolTip="Modifier la règle"
                        Style="{StaticResource IconButton}"
                        Width="32"
                        Height="32"
                        Padding="4">
                    <materialDesign:PackIcon Kind="PencilOutline"/>
                </Button>
                <Button Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        ToolTip="Supprimer la règle"
                        Style="{StaticResource IconButton}"
                        Width="32"
                        Height="32"
                        Padding="4">
                    <materialDesign:PackIcon Kind="DeleteOutline"/>
                </Button>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,8">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource SearchField}"/>
            <WrapPanel>
                <Button Command="{Binding RefreshCommand}"
                        ToolTip="Actualiser"
                        Style="{StaticResource ToolButton}">
                    <materialDesign:PackIcon Kind="Refresh"/>
                </Button>
                <Button Content="Ajouter une règle"
                        Command="{Binding AddRuleCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,0,6"/>
            </WrapPanel>
            <ProgressBar IsIndeterminate="True"
                         Height="3"
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"
                                  MinWidth="220"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0"
                      ItemsSource="{Binding FilteredItems}"
                      SelectedItem="{Binding SelectedSecurityGroup}"
                      Style="{StaticResource ResourceList}"
                      Margin="0,0,16,0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding GroupName}"
                                       Style="{StaticResource ResourceName}"/>
                            <TextBlock Text="{Binding GroupId}"
                                       Style="{StaticResource ResourceIdentifier}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Description}"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="12"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Column="1"
                  DataContext="{Binding SelectedSecurityGroup}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                        Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right"
                            Command="{Binding DataContext.AddRuleCommand, ElementName=SecurityGroupViewControl}"
                            CommandParameter="Ingress"
                            Style="{StaticResource IconButton}"
                            ToolTip="Ajouter une règle entrante">
                        <materialDesign:PackIcon Kind="Plus"/>
                    </Button>
                    <TextBlock Text="Entrées"
                               Style="{StaticResource SectionTitle}"
                               Margin="5"
                            VerticalAlignment="Center"/>
                </DockPanel>

                <DataGrid Grid.Row="1"
                          RowHeight="48"
                          Style="{StaticResource ResourceGrid}"
                          ItemsSource="{Binding IngressRules}"
                          Tag="{Binding ElementName=SecurityGroupViewControl, Path=DataContext}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow"
                               BasedOn="{StaticResource ResourceRow}">
                            <Setter Property="Tag"
                                    Value="{Binding ElementName=SecurityGroupViewControl, Path=DataContext}"/>
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="Delete"
                                                  Command="{Binding PlacementTarget.Tag.DeleteRuleCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Edit"
                                                  Command="{Binding PlacementTarget.Tag.EditRuleCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>

                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn CellTemplate="{StaticResource RuleActions}"
                                                Width="100"/>
                        <DataGridTextColumn Header="Protocole"
                                            Binding="{Binding Protocol}"/>
                        <DataGridTextColumn Header="Ports"
                                            Binding="{Binding PortRange}"/>
                        <DataGridTextColumn Header="Source"
                                            Binding="{Binding SourceOrDestination}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Description"
                                            Binding="{Binding Description}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <DockPanel Grid.Row="2"
                        Margin="0,16,0,8">
                    <Button DockPanel.Dock="Right"
                            Command="{Binding DataContext.AddRuleCommand, ElementName=SecurityGroupViewControl}"
                            CommandParameter="Egress"
                            Style="{StaticResource IconButton}"
                            ToolTip="Ajouter une règle sortante">
                        <materialDesign:PackIcon Kind="Plus"/>
                    </Button>
                    <TextBlock Text="Sorties"
                            Style="{StaticResource SectionTitle}"
                            Margin="5"
                            VerticalAlignment="Center"/>
                </DockPanel>
                <DataGrid Grid.Row="3"
                          RowHeight="48"
                          Style="{StaticResource ResourceGrid}"
                          ItemsSource="{Binding EgressRules}"
                          Tag="{Binding ElementName=SecurityGroupViewControl, Path=DataContext}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow"
                               BasedOn="{StaticResource ResourceRow}">
                            <Setter Property="Tag"
                                    Value="{Binding ElementName=SecurityGroupViewControl, Path=DataContext}"/>
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="Delete"
                                                  Command="{Binding PlacementTarget.Tag.DeleteRuleCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Edit"
                                                  Command="{Binding PlacementTarget.Tag.EditRuleCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn CellTemplate="{StaticResource RuleActions}"
                                                Width="100"/>
                        <DataGridTextColumn Header="Protocole"
                                            Binding="{Binding Protocol}"/>
                        <DataGridTextColumn Header="Ports"
                                            Binding="{Binding PortRange}"/>
                        <DataGridTextColumn Header="Destination"
                                            Binding="{Binding SourceOrDestination}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
        <TextBlock Grid.Row="1"
                   Style="{StaticResource ResourceEmptyState}"/>
    </Grid>
</UserControl>
