<UserControl x:Class="AwsManager.Views.Route53View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:AwsManager.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:Route53ViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="600"
             d:DesignWidth="1200">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"
                              MinWidth="210"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0"
              Panel.ZIndex="1"
              Grid.ColumnSpan="2"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"/>
                <TextBlock Text="Chargement..."
                           FontSize="16"
                           Margin="10,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Hosted Zones List -->
        <DockPanel Grid.Column="0"
                   Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top"
                       Style="{StaticResource SectionTitle}"
                       Text="Zones (service global)"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="5"/>
            <Button DockPanel.Dock="Top"
                    Style="{StaticResource ActionButton}"
                    Content="Actualiser les zones"
                    Command="{Binding RefreshCommand}"
                    Margin="5,0,5,5"/>
            <ListView ItemsSource="{Binding HostedZones}"
                      Style="{StaticResource ResourceList}"
                      SelectedItem="{Binding SelectedHostedZone}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}"
                                       Style="{StaticResource ResourceName}"/>
                            <TextBlock Text="{Binding Id}"
                                       Style="{StaticResource ResourceIdentifier}"
                                    Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Comment}"
                                       FontStyle="Italic"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </DockPanel>

        <!-- Resource Record Sets -->
        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Style="{StaticResource SectionTitle}"
                        TextTrimming="CharacterEllipsis"
                           Margin="5,5,5,0">
                    <Run Text="Zone :"/>
                    <Run Text="{Binding SelectedHostedZone.Name, TargetNullValue='Aucune zone sélectionnée', FallbackValue='Aucune zone sélectionnée'}"
                         FontWeight="Bold"/>
                </TextBlock>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SearchField}"/>
                <WrapPanel Margin="0,5">
                    <Button Content="Créer"
                            Command="{Binding CreateRecordCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,6,6"/>
                    <Button Content="Modifier"
                            Command="{Binding UpdateRecordCommand}"
                            Style="{StaticResource ToolButton}"/>
                    <Button Command="{Binding DeleteRecordCommand}"
                            ToolTip="Supprimer l'enregistrement"
                            Foreground="Firebrick"
                            Style="{StaticResource ToolButton}">
                        <materialDesign:PackIcon Kind="DeleteOutline"/>
                    </Button>
                </WrapPanel>
            </StackPanel>
            <DataGrid ItemsSource="{Binding FilteredItems}"
                      SelectedItem="{Binding SelectedRecordSet, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Style="{StaticResource ResourceGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nom"
                                        ElementStyle="{StaticResource ResourceName}"
                            MinWidth="150"
                                        Binding="{Binding Name}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding Type}"/>
                    <DataGridTextColumn Header="Routage"
                                        Binding="{Binding Routing}"/>
                    <DataGridTextColumn Header="TTL"
                                        Binding="{Binding TTL}"/>
                    <DataGridTextColumn Header="Valeur"
                                        ElementStyle="{StaticResource ResourceIdentifier}"
                            MinWidth="140"
                                        Binding="{Binding Value}"
                                        Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <TextBlock Grid.Column="1"
                   Style="{StaticResource ResourceEmptyState}"/>
    </Grid>
</UserControl>
