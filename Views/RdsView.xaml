<UserControl x:Class="AwsManager.Views.RdsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:AwsManager.ViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:RdsViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="600"
             d:DesignWidth="1000">
        <UserControl.Resources>
                <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </UserControl.Resources>
        <Grid>
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,8">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchField}"/>
                        <WrapPanel>
                                <Button Command="{Binding RefreshCommand}"
                                        ToolTip="Actualiser"
                                        Style="{StaticResource ToolButton}">
                                        <materialDesign:PackIcon Kind="Refresh"/>
                                </Button>
                                <Button Command="{Binding ConnectCommand}"
                                                Style="{StaticResource PrimaryButton}"
                                                Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="LanConnect"
                                                                Width="16"
                                                                Height="16"
                                                                Margin="0,0,8,0"/>
                                                <TextBlock Text="Connexion SSM"/>
                                        </StackPanel>
                                </Button>
                                <Button Command="{Binding StartDbInstanceCommand}"
                                        ToolTip="Démarrer la base"
                                        Style="{StaticResource ToolButton}">
                                        <materialDesign:PackIcon Kind="Play"/>
                                </Button>
                                <Button Command="{Binding StopDbInstanceCommand}"
                                        ToolTip="Arrêter la base"
                                        Style="{StaticResource ToolButton}">
                                        <materialDesign:PackIcon Kind="Stop"/>
                                </Button>
                                <Button Content="Créer un snapshot"
                                        Command="{Binding CreateDbSnapshotCommand}"
                                        Style="{StaticResource ToolButton}"/>
                                <Button Content="Tags"
                                        Command="{Binding EditTagsCommand}"
                                        Style="{StaticResource ToolButton}"/>
                                <Button Content="Détails"
                                        Command="{Binding ViewDetailsCommand}"
                                        Style="{StaticResource ToolButton}"/>
                        </WrapPanel>
                        <ProgressBar IsIndeterminate="True"
                                     Height="3"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding FilteredItems}"
                          SelectedItem="{Binding SelectedInstance}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          Style="{StaticResource ResourceGrid}">
                        <DataGrid.Columns>
                                <DataGridTextColumn Header="Identifiant"
                                                    ElementStyle="{StaticResource ResourceName}"
                                                    MinWidth="180"
                                                    Binding="{Binding DbInstanceIdentifier}"/>
                                <DataGridTextColumn Header="Classe"
                                                    Binding="{Binding DbInstanceClass}"/>
                                <DataGridTextColumn Header="Moteur"
                                                    Binding="{Binding Engine}"/>
                                <DataGridTemplateColumn Header="État"
                                                        SortMemberPath="DbInstanceStatus"
                                                        Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                        <ContentControl Content="{Binding DbInstanceStatus}"
                                                                        Style="{StaticResource StateBadge}"/>
                                                </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Adresse"
                                                    ElementStyle="{StaticResource ResourceIdentifier}"
                                                    MinWidth="170"
                                                    Binding="{Binding EndpointAddress}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Stockage (Go)"
                                                    Binding="{Binding AllocatedStorage}"/>
                                <DataGridCheckBoxColumn Header="Multi-AZ"
                                                        Binding="{Binding MultiAZ}"/>
                                <DataGridTextColumn Header="Groupes de sécurité"
                                                    Binding="{Binding SecurityGroups}"
                                                    Width="*"/>
                        </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="1"
                           Style="{StaticResource ResourceEmptyState}"/>
        </Grid>
</UserControl>
