<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en;fr</SatelliteResourceLanguages>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**</DefaultItemExcludes>
    <PackageIcon>aws.png</PackageIcon>
    <ApplicationIcon>amazon_aws_logo_icon_145507.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="aws.png" />
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <None Remove="tests\**\*" />
    <Page Remove="tests\**\*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="amazon_aws_logo_icon_145507.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="aws.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.Core" Version="4.0.102.6" />
    <PackageReference Include="AWSSDK.CloudWatch" Version="4.0.104.4" />
    <PackageReference Include="AWSSDK.CloudWatchLogs" Version="4.0.104.3" />
    <PackageReference Include="AWSSDK.IdentityManagement" Version="4.0.103.6" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
    <PackageReference Include="AWSSDK.EC2" Version="4.0.123" />
    <PackageReference Include="AWSSDK.Route53" Version="4.0.100.14" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.3" />

    <PackageReference Include="AWSSDK.RDS" Version="4.0.105.3" />
    <PackageReference Include="AWSSDK.AutoScaling" Version="4.0.104.3" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="4.0.101" />
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="4.0.103.9" />
    <PackageReference Include="AWSSDK.SSO" Version="4.0.100.16">
      <TreatAsUsed>true</TreatAsUsed>
    </PackageReference>
    <PackageReference Include="AWSSDK.SSOOIDC" Version="4.0.100.15">
      <TreatAsUsed>true</TreatAsUsed>
    </PackageReference>
    <PackageReference Include="MaterialDesignThemes" Version="5.3.0">
      <TreatAsUsed>true</TreatAsUsed>
    </PackageReference>
    <PackageReference Include="Microsoft-WindowsAPICodePack-Shell" Version="1.1.5" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135">
      <TreatAsUsed>true</TreatAsUsed>
    </PackageReference>

  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Views\Dialogs\ASGTagEditorWindow.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\Dialogs\EditSGRecordSetWindow.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Update="aws.ico">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>