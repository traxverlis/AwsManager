<Window x:Class="AwsManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewModels="clr-namespace:AwsManager.ViewModels"
        xmlns:views="clr-namespace:AwsManager.Views"
        mc:Ignorable="d"
        Title="AWS Manager"
        Height="720"
        Width="1280"
        MinWidth="1000"
        MinHeight="640"
        TextElement.Foreground="{StaticResource InkBrush}"
        Background="{StaticResource CanvasBrush}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{StaticResource InterfaceFont}">

    <Window.Resources>
        <!-- Ensure that the ViewModel and View classes exist in the specified namespaces -->
        <DataTemplate DataType="{x:Type viewModels:Ec2ViewModel}">
            <views:Ec2View/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:S3ViewModel}">
            <views:S3View/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:RdsViewModel}">
            <views:RdsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AutoScalingViewModel}">
            <views:AutoScalingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SecurityGroupViewModel}">
            <views:SecurityGroupView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:Route53ViewModel}">
            <views:Route53View/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:LiveSessionsViewModel}">
            <views:LiveSessionsView/>
        </DataTemplate>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <DataTemplate DataType="{x:Type viewModels:WorkspaceViewModel}">
            <views:WorkspaceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:CloudWatchLogsViewModel}">
            <views:CloudWatchLogsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:IamViewModel}">
            <views:IamView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PatchViewModel}">
            <views:PatchView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation Rail -->
        <DockPanel Grid.Column="0"
                   Background="{StaticResource NavigationBrush}">
            <StackPanel DockPanel.Dock="Top" Margin="22,28,14,24">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#007E6C" Width="34" Height="34" CornerRadius="6" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="CloudOutline" Width="22" Height="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="AWS" FontFamily="{StaticResource HeadingFont}" FontSize="20" Foreground="White"/>
                        <TextBlock Text="Manager" FontSize="12" Foreground="#A6B8BE"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="RESSOURCES" FontSize="10" FontWeight="SemiBold" Foreground="#8EA3AC" Margin="2,28,0,0"/>
            </StackPanel>

            <Grid DockPanel.Dock="Bottom"
                Margin="14,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>

                <Button
                        Grid.Column="0"
                        Margin="0,0,5,0"
                        Style="{StaticResource ActionButton}"
                        Background="#303B3E" BorderBrush="#435053" Foreground="White"
                        Command="{Binding QuitCommand}">
                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Logout" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="Quitter"/></StackPanel>
                </Button>

                <Button ToolTip="Aide et références"
                    AutomationProperties.Name="Aide et références"
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        Style="{StaticResource IconButton}" Foreground="#A6B8BE"
                        Command="{Binding HelpCommand}">
                    <materialDesign:PackIcon Kind="InformationOutline"/>
                </Button>
            </Grid>

            <ListBox ItemsSource="{Binding Pages}"
                     SelectedItem="{Binding SelectedPage}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavigationItem}">
                        <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                        <Setter Property="ToolTip" Value="{Binding AccessHint}"/>
                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                        <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,6">
                            <materialDesign:PackIcon Kind="{Binding Icon}"
                                                     Width="20"
                                                     Height="20"
                                                     Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Name}"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Main Content -->
        <Grid Grid.Column="1"
              Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="ConnectionSummary"
                  Height="32"
                  Margin="0,0,0,12"
                  Visibility="{Binding IsConnectionCollapsed, Converter={StaticResource BoolVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="AccountCheckOutline"
                                         Foreground="{StaticResource AccentBrush}"
                                         Width="20"
                        Height="20"
                        Margin="0,0,10,0"
                                         VerticalAlignment="Center"
                        ToolTip="Connecté à AWS"/>
                <TextBlock Grid.Column="1"
                        Text="{Binding Session.Context.Profile}"
                           FontWeight="SemiBold"
                        VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                        Margin="0,0,16,0"
                           ToolTip="{Binding Session.Context.Identity}"/>
                <TextBlock Grid.Column="2"
                        Text="{Binding Session.Context.Account}"
                           VerticalAlignment="Center"
                        Margin="0,0,16,0"
                        ToolTip="Compte AWS"/>
                <TextBlock Grid.Column="3"
                        Text="{Binding Session.Context.Region}"
                           VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        ToolTip="Région AWS"/>
                <Button Grid.Column="4"
                        Command="{Binding ToggleConnectionPanelCommand}"
                    Style="{StaticResource IconButton}"
                        Width="32"
                        Height="32"
                        Padding="4"
                        ToolTip="Développer le bandeau de connexion"
                        AutomationProperties.Name="Développer le bandeau de connexion">
                    <materialDesign:PackIcon Kind="ChevronDown"/>
                </Button>
            </Grid>
            <WrapPanel x:Name="ConnectionControls"
                       Visibility="{Binding IsConnectionExpanded, Converter={StaticResource BoolVisibility}}">
                <ComboBox Width="230"
                          Margin="0,0,12,8"
                          ItemsSource="{Binding AwsProfiles}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedAwsProfile}"
                          Style="{StaticResource FormCombo}"
                          materialDesign:HintAssist.Hint="Profil AWS"/>
                <ComboBox Width="170"
                          Margin="0,0,12,8"
                          ItemsSource="{Binding Regions}"
                          SelectedItem="{Binding SelectedRegion}"
                          Style="{StaticResource FormCombo}"
                          materialDesign:HintAssist.Hint="Région"/>
                <Button Command="{Binding ReloadProfilesCommand}"
                    Style="{StaticResource ActionButton}"
                        ToolTip="Relire les profils"
                        Margin="0,0,8,8">
                    <materialDesign:PackIcon Kind="Refresh"/>
                </Button>
                <Button Command="{Binding VerifyCommand}"
                    Style="{StaticResource ActionButton}"
                        Content="Vérifier"
                        Margin="0,0,8,8"/>
                <Button Command="{Binding LoginCommand}"
                        Content="Connexion SSO"
                        Margin="0,0,8,8"/>
                <Button Command="{Binding CancelLoginCommand}"
                    Style="{StaticResource IconButton}"
                        ToolTip="Annuler la connexion"
                        Margin="0,0,0,8"
                        Visibility="{Binding Session.IsBusy, Converter={StaticResource BoolVisibility}}">
                    <materialDesign:PackIcon Kind="Close"/>
                </Button>
                <Button Command="{Binding ToggleConnectionPanelCommand}"
                    Style="{StaticResource IconButton}"
                        Width="32"
                        Height="32"
                        Padding="4"
                        Margin="0,0,0,8"
                        ToolTip="Réduire le bandeau de connexion"
                        AutomationProperties.Name="Réduire le bandeau de connexion"
                        Visibility="{Binding Session.IsConnected, Converter={StaticResource BoolVisibility}}">
                    <materialDesign:PackIcon Kind="ChevronUp"/>
                </Button>
            </WrapPanel>
            <StackPanel x:Name="ConnectionDetails"
                        Grid.Row="1"
                        Visibility="{Binding IsConnectionExpanded, Converter={StaticResource BoolVisibility}}"
                        Margin="0,2,0,16">
                <TextBlock Text="{Binding Session.Status}"
                           Foreground="{StaticResource MutedInkBrush}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Session.Context.Identity}"
                           FontSize="11"
                           Opacity="0.65"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Session.Context.Identity}"/>
                <ProgressBar IsIndeterminate="True"
                             Height="3"
                             Margin="0,6,0,0"
                             Visibility="{Binding Session.IsBusy, Converter={StaticResource BoolVisibility}}"/>
            </StackPanel>
            <DockPanel Grid.Row="2" Margin="0,4,0,18">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ShowRelationsCommand}" ToolTip="Ressources liées" Style="{StaticResource IconButton}"><materialDesign:PackIcon Kind="LinkVariant"/></Button>
                    <Button Command="{Binding ShowMonitoringCommand}" ToolTip="Supervision CloudWatch" Style="{StaticResource IconButton}" Margin="0,0,6,0"><materialDesign:PackIcon Kind="ChartLine"/></Button>
                    <Button Command="{Binding ToggleFavoriteCommand}" ToolTip="Ajouter ou retirer la ressource des favoris" Style="{StaticResource IconButton}" Margin="0,0,12,0">
                        <materialDesign:PackIcon>
                            <materialDesign:PackIcon.Style><Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Kind" Value="StarOutline"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Kind" Value="Star"/><Setter Property="Foreground" Value="#AD7C28"/></DataTrigger></Style.Triggers>
                            </Style></materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                    </Button>
                    <CheckBox Content="Lecture seule" IsChecked="{Binding IsReadOnly}" ToolTip="Bloque les écritures AWS et les nouvelles sessions SSM ; ne ferme pas les sessions déjà ouvertes."/>
                </StackPanel>
                <TextBlock Text="{Binding SelectedPage.Name}" FontFamily="{StaticResource HeadingFont}" FontSize="26" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <ContentControl Grid.Row="3"
                            Content="{Binding CurrentViewModel}"/>
            <StackPanel Grid.Row="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowConnection, Converter={StaticResource BoolVisibility}}">
                <materialDesign:PackIcon Kind="AccountKeyOutline"
                                         Foreground="{StaticResource AccentBrush}"
                                         Width="48"
                                         Height="48"
                                         HorizontalAlignment="Center"
                                         Margin="0,0,0,12"/>
                <TextBlock Text="{Binding ConnectionPrompt}"
                           FontFamily="{StaticResource HeadingFont}"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>
                <Button Content="Connexion SSO"
                        Command="{Binding LoginCommand}"
                        HorizontalAlignment="Center"/>
            </StackPanel>
            <DockPanel Grid.Row="4" Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Command="{Binding RefreshPermissionsCommand}" Style="{StaticResource IconButton}"
                        ToolTip="Reevaluer les droits IAM du profil connecte" AutomationProperties.Name="Reevaluer les droits IAM">
                    <materialDesign:PackIcon Kind="ShieldRefreshOutline"/>
                </Button>
                <TextBlock Text="{Binding PermissionStatus}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedInkBrush}"/>
            </DockPanel>
            <Border x:Name="NotificationBanner" Grid.Row="5" Margin="0,12,0,0" Padding="12,6" Background="#E8F1F9" BorderBrush="#77A5C8" BorderThickness="3,0,0,0" CornerRadius="4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Notification}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            <DataTrigger Binding="{Binding Notification}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Command="{Binding DismissNotificationCommand}"
                        ToolTip="Effacer la notification"
                        Style="{StaticResource IconButton}">
                    <materialDesign:PackIcon Kind="Close"/>
                </Button>
                <TextBlock Text="{Binding Notification}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           MaxHeight="70"/>
            </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
